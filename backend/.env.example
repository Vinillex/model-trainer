# Copy to .env and fill in. Never commit .env.
MT_SERPAPI_KEY=
# Needed to train on RunPod (python -m scripts.runpod, see agents/RUNPOD.md). A key limited to pods/endpoints is enough.
MT_RUNPOD_API_KEY=
# Optional: a private Cloudflare R2 bucket for the training zips, so RunPod pods download the dataset from there instead of
# through this Mac's slow upload link. Use an R2 API token limited to this one bucket (Object Read & Write). All four or none.
# MT_DATASET_BUCKET=model-trainer-datasets
# MT_DATASET_BUCKET_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# MT_DATASET_BUCKET_ACCESS_KEY=
# MT_DATASET_BUCKET_SECRET_KEY=
# Shared secret for the GPU/Pi workers (any long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))")
MT_WORKER_TOKEN=
# MT_DATABASE_URL=postgresql+psycopg://user:pass@host/db
# MT_STORAGE_BACKEND=s3

# AI check (needs `pip install -r requirements-ai.txt`; see HANDOVER.md section 4.8). All optional.
# MT_AI_SAM_WEIGHTS=sam2.1_s.pt        # sam2.1_t.pt (fastest), _s.pt, _b.pt, _l.pt (best); downloaded on first use
# MT_AI_DETECTOR_WEIGHTS=              # a .pt path; default = best.pt of the newest finished training run
# MT_AI_DEVICE=                        # mps / cpu / cuda; default = the Mac's GPU when torch has it
